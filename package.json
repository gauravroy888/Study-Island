{
  "name": "edtech-island-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "build:admin": "npm run build --prefix portals/admin",
    "build:student": "npm run build --prefix portals/student",
    "build:teacher": "npm run build --prefix portals/teacher",
    "build:superadmin": "npm run build --prefix portals/superadmin",
